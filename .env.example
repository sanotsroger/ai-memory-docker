# Versão da imagem Docker do ai-memory (akitaonrails/ai-memory)
VERSION=2.1.0

# Porta local (127.0.0.1) onde o ai-memory ficará disponível
PORT=49374

# Raiz dos repositórios, montada read-only no container no MESMO caminho absoluto.
# Os hooks rodam dentro do container: sem isso eles não enxergam o .git nem o
# .ai-memory.toml e derivam o projeto de basename(cwd), criando um escopo separado
# para cada subpasta em que você abrir uma sessão (ex.: scripts/sqlserver).
# Precisa ser caminho absoluto — `~` não é expandido aqui.
PROJECTS_DIR=/home/SEU_USUARIO/Projects
