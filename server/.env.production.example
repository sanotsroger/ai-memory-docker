# Copiado para server/.env.production por `make server-init` (gitignored).
# O mesmo arquivo serve de env_file do container e de --env-file do compose.

# Versão da imagem (akitaonrails/ai-memory)
VERSION=3.2.2

# Porta publicada no host (0.0.0.0) e diretório de dados (dono 1000:1000)
PORT=49374
SERVER_DATA_DIR=/var/opt/ai-memory/data

# Token bearer exigido de todo cliente. `make server-init` gera um com
# `ai-memory generate-auth-token` quando este campo está vazio.
AI_MEMORY_AUTH_TOKEN=

# Todo nome ou IP pelo qual os clientes chegam ao servidor. O Traefik repassa o
# Host original (passHostHeader), então o domínio basta; inclua o IP do LXC se
# for acessar direto por http://<ip>:49374.
AI_MEMORY_ALLOWED_HOSTS=memo.sanotsroger.com.br,localhost,127.0.0.1

# O /web é servido em HTTPS pelo Traefik: o cookie de sessão precisa ser Secure.
AI_MEMORY_AUTH__SECURE_COOKIE=true

# -- LLM (opcional) ---------------------------------------------------
# Sem provedor, a consolidação usa resumos por regras e a busca é só FTS5.
# Para ligar, descomente e rode `make server-start` de novo. Opções e custos:
# https://github.com/akitaonrails/ai-memory/blob/main/docs/deploy.md#llm-provider-choices
# AI_MEMORY_LLM_PROVIDER=anthropic
# AI_MEMORY_LLM_MODEL=claude-haiku-4-5
# ANTHROPIC_API_KEY=sk-ant-...
#
# Embeddings (busca híbrida), também opcionais:
# AI_MEMORY_EMBEDDING_PROVIDER=openai
# AI_MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# AI_MEMORY_EMBEDDING_DIM=1536
# OPENAI_API_KEY=sk-...
